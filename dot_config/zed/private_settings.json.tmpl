// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha"
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  },
  "cli_default_open_behavior": "existing_window",
  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "base_keymap": "VSCode",
  "vim_mode": true,
  "vim": {
    // "always": use system clipboard when no register is specified
    // "never": don't use system clipboard unless "+ or "* is specified
    // "on_yank": use system clipboard for yank operations when no register is specified
    "use_system_clipboard": "always"
  },
  "which_key": {"enabled": true},
  "load_direnv": "direct",
  "use_smartcase_search": true,
  "wrap_guides": [80, 100, 120],
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "current_line_highlight": "all",
  "cursor_blink": false,
  "relative_line_numbers": "disabled",
  "scrollbar": { "show": "auto" },
  "vertical_scroll_margin": 8,
  "buffer_line_height": "standard",
  "ui_font_size": 16,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 16,
  "remove_trailing_whitespace_on_save": true,
  "project_panel": {
    "starts_open": false,
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/.venv"
  ],
  "agent": {
    "dock": "left",
    "enable_feedback": false,
    "default_profile": "write"
  },
  "outline_panel": {
    "dock": "right"
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 2,
    "coloring": "fixed",
    "background_coloring": "disabled"
  },
  "use_autoclose": false,
  "always_treat_brackets_as_autoclosed": false,
  "sticky_scroll": {"enabled": false},
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true
  },
  "tabs": {
    "close_position": "right",
    "file_icons": false,
    "git_status": true
  },
  "format_on_save": "off",
  "file_types": {
    "Dockerfile": ["Dockerfile*"]
  },
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "fish",
        "args": ["-i"]
      }
    },
    "font_family": "JetBrainsMono Nerd Font",
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
        "activate_script": "fish"
      }
    },
  },
  "git_hosting_providers": [
    {
      "provider": "github",
      "name": "GitHub",
      "base_url": "https://github.com"
    }
  ],
  "lsp": {
    "gopls": {
      "initialization_options": {
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true
        }
      }
    },
    "ty": {},
    "ruff": {
      "initialization_options": {
        "settings": {
          // Ruff server settings goes here
          "lineLength": 100,
          "lint": {
            "extendSelect": ["I"]
          }
        }
      }
    },
    "jj-lsp": {
      "initialization_options": {
        "check": {
          "command": "jj-lsp"
        }
      }
    }
  },
  "languages": {
    "Python": {
      "language_servers": ["ty"],
    }
  }
}
